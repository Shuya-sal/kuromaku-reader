<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Televisi tidak punya layar sentuh. Tanpa menyatakan sentuh sebagai
        fitur opsional, Play Store menyaring aplikasi ini dari perangkat TV dan
        sebagian peluncur TV menolak memasangnya.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Leanback hanya untuk tampilan panduan TV; aplikasi tetap jalan tanpanya. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Progress notification for volume downloads (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Unduhan besar berjalan sebagai foreground worker dengan progres. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".KuromakuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.Kuromaku">

        <activity
            android:name=".SourceHubActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Muncul di peluncur Android TV. Tanpa ini aplikasi hanya
                     terlihat di peluncur perangkat sentuh. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".shinigami.ShinigamiDownloadsActivity"
            android:exported="false" />

        <activity
            android:name=".MangaActivity"
            android:exported="false" />

        <activity
            android:name=".shinigami.ShinigamiActivity"
            android:exported="false" />

        <activity
            android:name=".komiku.KomikuActivity"
            android:exported="false" />
        <activity
            android:name=".komiku.KomikuDetailActivity"
            android:exported="false" />
        <activity
            android:name=".komiku.KomikuReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".anime.OtakudesuActivity"
            android:exported="false"
            android:configChanges="uiMode" />

        <activity
            android:name=".anime.OtakudesuDetailActivity"
            android:exported="false" />

        <activity
            android:name=".anime.AnimePlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity
            android:name=".anime.AnimeDownloadsActivity"
            android:exported="false"
            android:label="Unduhan Anime" />

        <activity
            android:name=".shinigami.ShinigamiDetailActivity"
            android:exported="false" />

        <activity android:name=".shinigami.ShinigamiImageZoomActivity" android:exported="false" />

        <activity
            android:name=".shinigami.ShinigamiReaderActivity"
            android:exported="false" />

        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ImageViewerActivity"
            android:exported="false"
            android:parentActivityName=".ReaderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- WorkManager menjalankan pekerjaan unduhan sebagai foreground service. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".offline.DownloadCancelReceiver"
            android:exported="false"
            android:enabled="true" />
    </application>
</manifest>
